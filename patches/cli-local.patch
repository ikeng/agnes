+  ];
+  cases.forEach(([body, pattern], index) => {
+    const path = writeFile(dir, `by-kind-bad-${index}.json`, JSON.stringify(body));
+    assert.match(parseAndThrow(path).message, pattern, `case ${index}`);
+  });
+});
