+
+function accountsFile(t, document, mode = 0o600) {
+  const dir = tempDir(t);
+  const file = join(dir, "accounts.json");
+  writeFileSync(file, JSON.stringify(document), { mode });
+  chmodSync(file, mode);
+  return file;
