+    },
+  );
+});
+
+test("explicit route.accountId overrides the journal (recovery path)", async (t) => {
+  const server = await withServer(t, [{ key: "sk-test-a", id: "a" }, { key: "sk-test-b", id: "b" }]);
+  const dir = tempDir(t);
