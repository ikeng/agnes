+});
+
+test("session affinity keeps one account across calls and processes", async (t) => {
+  const server = await withServer(t, [{ key: "sk-test-a", id: "a" }, { key: "sk-test-b", id: "b" }]);
+  const dir = tempDir(t);
+  const stateDir = join(dir, "state");
