+    assert.equal(result.attempts, 1);
+  }
+  await assert.rejects(
+    () => router.execute({ workload: "text", method: "POST", accountId: "a", maxWaitMs: 50 }, send),
+    (error) => {
+      assert.equal(error.code, "RATE_LIMITED");
