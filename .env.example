# Copy to .env.local and fill in. .env.local is gitignored and must stay mode 600.
AGNES_API_KEY=sk-your-key

# Optional gateway override (default https://apihub.agnes-ai.com/v1).
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# On this machine Litterbox is blocked (403/412) and tmpfiles has TLS issues;
# put the working providers first. Allowed: litterbox, tmpfiles, uguu, x0.
AGNES_MEDIA_PROVIDER_ORDER=uguu,x0,litterbox,tmpfiles

# Optional: request timeout in milliseconds (default 120000).
# AGNES_HTTP_TIMEOUT_MS=120000
# Optional: disable automatic .env.local loading (CLI only).
# AGNES_NO_DOTENV=1

# ---------------------------------------------------------------------------
# Multi-account routing (optional, 2026-10)
#
# Same-type keys on one account do NOT stack rate limits; only distinct
# accounts or distinct key types (free / enterprise / tokenplan) are separate
# pools. When any AGNES_ACCOUNT_<ID>_KEY is set, AGNES_API_KEY above is ignored
# for routing (a warning is printed). Group keys that share one account into the
# same POOL so client-side pacing matches the real API limit.
#
# Precedence: AGNES_ACCOUNTS_FILE > indexed env (AGNES_ACCOUNT_*) > AGNES_API_KEY.
# ---------------------------------------------------------------------------
# AGNES_ACCOUNTS=main,backup                       # optional order; default sorted ids
# AGNES_ACCOUNT_MAIN_KEY=sk-your-key
# AGNES_ACCOUNT_MAIN_TYPE=free                     # free | enterprise | tokenplan
# AGNES_ACCOUNT_MAIN_POOL=acct-main                # default: account id
# AGNES_ACCOUNT_MAIN_WEIGHT=1                      # weighted strategy weight
# AGNES_ACCOUNT_MAIN_PRIORITY=0                    # lower is preferred by primary
# AGNES_ACCOUNT_MAIN_CONCURRENCY=2                 # optional, else type preset
# AGNES_ACCOUNT_MAIN_MODELS=agnes-image-2.5-flash,agnes-video-2.5
# AGNES_ACCOUNT_MAIN_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_ACCOUNT_MAIN_LABEL=main-free
#
# AGNES_ACCOUNT_BACKUP_KEY=sk-your-key
# AGNES_ACCOUNT_BACKUP_TYPE=tokenplan
# AGNES_ACCOUNT_BACKUP_POOL=acct-backup

# Routing / pacing (defaults shown).
# AGNES_ROUTING_STRATEGY=adaptive                  # adaptive | round-robin | weighted | least-inflight | primary
# AGNES_ROUTING_MAX_ATTEMPTS=3                     # per request, across eligible pools
# AGNES_ROUTING_MAX_WAIT_MS=60000                  # max wait for capacity/cooldown
# AGNES_RATE_LIMIT=on                              # on | off (client-side pacing)
# AGNES_STATE_DIR=~/.agnes/state                   # affinity journal (dir 0700, files 0600)
# AGNES_POLL_INTERVAL_MS=2000                      # status poll pacing floor
# AGNES_POLL_TIMEOUT_MS=600000                     # default poll budget

# Accounts file (explicit path only; chmod 600 it: it can contain API keys).
# AGNES_ACCOUNTS_FILE=/absolute/path/accounts.json
# Set to 1 to silence the "accounts file is readable by group/other" warning.
# AGNES_ACCOUNTS_ALLOW_INSECURE=1
